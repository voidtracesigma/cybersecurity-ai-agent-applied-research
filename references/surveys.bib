@article{potter2025frontier,
  title={Frontier AI's Impact on the Cybersecurity Landscape},
  author={Yujin Potter etc},
  journal={arXiv preprint arXiv:2504.05408},
  year={2025},
  desc={Comprehensive analysis (benchmarks, literature, experiments, expert survey) of how frontier AI (LLMs and agent systems) affects cybersecurity. It finds that AI’s current offensive capabilities often outpace its defensive use, highlights gaps in defensive tooling and benchmarking, reports expert views that attackers benefit more from AI (though the gap may narrow), and offers actionable recommendations to improve defense-focused benchmarks, secure AI deployment, and education.}
}
@article{xu2025forewarned,
  title={Forewarned is forearmed: A survey on large language model-based agents in autonomous cyberattacks},
  author={Minrui Xu},
  journal={arXiv preprint arXiv:2505.12786},
  year={2025},
  desc={Systematic survey of how advanced LLM-based agents can autonomously plan and execute cyberattacks—reducing expertise/time needed and enabling scalable operations. It categorizes agent capabilities (e.g., reconnaissance, reasoning, memory), examines attack techniques across network types, identifies limitations and defense challenges, and suggests future defensive research directions.}
}
@article{mayoral2026towards,
  title={Towards Cybersecurity Superintelligence: from AI-guided humans to human-guided AI},
  author={Mayoral-Vilches},
  journal={arXiv preprint arXiv:2601.14614},
  year={2026},
  desc={argues that cybersecurity will evolve from AI merely assisting human defenders to a human-guided cybersecurity superintelligence where humans set goals, constraints, and ethics while AI autonomously detects, reasons about, and mitigates threats at scale.}
}
@article{happe2025surprising,
  title={On the Surprising Efficacy of LLMs for Penetration-Testing},
  author={Happe},
  journal={arXiv preprint arXiv:2507.00829},
  year={2025},
  desc={shows that large language models (LLMs) are surprisingly effective at performing penetration-testing tasks—due to their pattern-matching and reasoning abilities—yet it also highlights challenges around reliability, safety, ethics, and dual-use risks in automating offensive security work.}
}